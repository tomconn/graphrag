# Copy to .env and edit — see README "Configuration reference"

# --- Ollama (via local daemon proxying to Ollama Cloud) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=glm-5.3-flash:cloud

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- Embeddings (identical for agent + ingest — shared vector space) ---
EMBEDDING_MODEL=mixedbread-ai/mxbai-embed-large-v1
EMBEDDING_DIM=1024

# --- Agent ---
RETRIEVAL_MODE=hybrid   # hybrid | vector (vector = evaluation baseline)
AGENT_MAX_TOKENS=4096   # completion budget per agent LLM call (unbounded-consumption guard)

# --- Ingest ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
INGEST_CONCURRENCY=6   # concurrent extraction LLM calls (bounded for rate limits)
EXTRACT_MAX_TOKENS=8192  # base completion budget per extraction attempt (doubled on retry)
INGEST_STALL_SECONDS=600 # watchdog: warn after this long with no log activity, force-exit after 2x

# --- UI backend ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000  # browser origins allowed to call the UI backend (comma-separated)

# --- Ports ---
AGENT_PORT=8001
UI_PORT=3000
FASTAPI_PORT=8000